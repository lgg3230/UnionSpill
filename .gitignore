# ----- Tables: track .tex, ignore CSVs and archives -----
Tables/**/*.csv
Tables/*.zip
Tables/**/*.zip

# ----- Graphs: track PDFs and PNGs, ignore Stata .gph files -----
Graphs/**/*.gph
Graphs/plots jul 31/*.gph

# ----- Reference literature PDFs (copyrighted; keep converted .md, not the PDFs) -----
Docs/Permutation_Placebo/*.pdf

# ----- Nested repo (old cluster sync copy — not part of this repo) -----
UnionSpill/
UnionSpill-paper/

# ----- Packaged standalone archive (exceeds GitHub 100MB limit; dir itself is tracked) -----
layer_connectivity_standalone.zip

# ----- Generated outputs: no NEW .tex / .csv / .pdf enter the repo -----
# Repo-wide, deliberate policy change (2026-07-31). Supersedes the CLAUDE.md
# note that Tables/*.csv, Tables/*.tex and Graphs/*.pdf are tracked.
#
# NOTE: this does not untrack anything. The ~1,959 such files already committed
# stay tracked and keep their history -- git ignores only untracked paths. To
# drop one later:  git rm --cached <path>
*.tex
*.csv
*.pdf

# Data formats. Same policy: no NEW data files enter the repo. 51 are already
# tracked (22 .dta, 29 .parquet), mostly under Data/layer_connectivity/, and
# they stay tracked -- see the note above.
*.dta
*.parquet

# ----- LaTeX compilation support files -----
# *.log is already ignored at line 20. The same rules are mirrored in
# UnionSpill-paper/.gitignore, which is a separate Overleaf repo.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
*.auxlock
*.figlist
*.spl

# Files already tracked under the rule above, re-asserted so the intent survives
# if they are ever removed and re-added.
!Data/RAIS_aux/totalflows_wide_2007_2011.csv

# ----- Re-ignore macOS noise even inside force-included dirs (must come last) -----
**/.DS_Store

# Archived data baselines (frozen analysis panel, retired overlay directory).
# Data, not code -- mirrors the Data/* rule above.
archive/Data/
